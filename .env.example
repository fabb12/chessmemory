# Account con Supabase (facoltativo). Senza questi valori l'app funziona solo in locale.
# Si trovano in Supabase → Project Settings → API. La chiave «anon»/«publishable» è pubblica:
# la protezione dei dati è affidata alle regole RLS definite in supabase/migrations.
VITE_SUPABASE_URL=https://il-tuo-progetto.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-chiave-anon
